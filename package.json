    "deploy": "wrangler deploy",
    "register": "tsx scripts/register.ts",
    "migrate:local": "wrangler d1 migrations apply geulgae-bot-db --local",
    "migrate:remote": "wrangler d1 migrations apply geulgae-bot-db --remote"
  },
  "keywords": [],
